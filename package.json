{
  "name": "phs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "DISABLE_ESLINT_PLUGIN=true next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "tsc-check": "tsc --noEmit",
    "pre-push": "npm run tsc-check && npm run lint",
    "pre-commit": "npm run update-types && (npm run tsc-check || true) && npm run lint",
    "update-types": "npx supabase gen types typescript --project-id 'qkkuacqtcsfjbnzmxmhk' > src/types/supabase.ts"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run pre-commit"
    }
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@next/env": "^16.4.3",
    "@next/third-parties": "^16.4.3",
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "crypto": "^1.0.1",
    "html5-qrcode": "^2.3.8",
    "i": "^0.3.7",
    "leaflet": "^1.9.4",
    "moment": "^2.31.0",
    "next": "^16.4.3",
    "node": "^24.22.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-responsive-carousel": "^3.2.23",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "daisyui": "^3.9.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "supabase": "^2.122.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.css": "stylelint --fix",
    "*.md": "markdownlint"
  }
}
